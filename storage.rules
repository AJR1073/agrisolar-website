rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isApprovedAdmin() {
      return request.auth != null
        && request.auth.token.email == 'aaronreifschneider@outlook.com';
    }

    match /quote-attachments/{submissionId}/{attachmentId} {
      allow create: if (request.auth == null || isApprovedAdmin())
        && resource == null
        && submissionId.matches('^[A-Za-z0-9_-]{10,64}$')
        && attachmentId.matches('^[A-Za-z0-9_-]{10,80}$')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches(
          '^(application/pdf|image/jpeg|image/png|image/webp)$'
        );
      allow read: if isApprovedAdmin();
      allow update, delete: if false;
    }
  }
}
