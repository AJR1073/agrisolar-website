    },
    "approval_requests": {
      ".read": "auth != null && auth.token.email == 'aaronreifschneider@outlook.com'",
      ".write": false,
      ".indexOn": [
        "organizationId",
        "status",
        "requestedAt"
      ]
    },
    "audit_events": {
      ".read": "auth != null && auth.token.email == 'aaronreifschneider@outlook.com'",
      ".write": false,
      ".indexOn": [
        "organizationId",
        "occurredAt",
        "actorId",
        "action",
        "requestId"
      ]
    },
    "idempotency_records": {
      ".read": false,
      ".write": false
    },
    "rate_limit_counters": {
      ".read": false,
      ".write": false
    },
    "email_recipients": {
      ".read": "auth != null && auth.token.email == 'aaronreifschneider@outlook.com'",
      "$recipient": {
        ".write": "auth != null && auth.token.email == 'aaronreifschneider@outlook.com'",
        ".validate": "newData.hasChildren(['name', 'email'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length > 3 && newData.val().length <= 254 && newData.val().matches(/^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
