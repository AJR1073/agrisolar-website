{
  "rules": {
    ".read": false,
    ".write": false,
    "contact_submissions": {
      ".read": "auth != null && auth.token.email == 'aaronreifschneider@outlook.com'",
      "$submission": {
        ".write": "(auth != null && auth.token.email == 'aaronreifschneider@outlook.com' && newData.exists()) || (auth == null && !data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['name', 'email', 'siteLocation', 'service', 'message', 'timestamp', 'status', 'viewed'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "company": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length > 3 && newData.val().length <= 254 && newData.val().matches(/^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$/)"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "siteLocation": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 160"
        },
        "acreage": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "service": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "schedule": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
        },
        "attachments": {
          "$attachment": {
            ".validate": "$attachment.matches(/^[0-9]$/) && newData.hasChildren(['name', 'contentType', 'size', 'path'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 140"
            },
            "contentType": {
              ".validate": "newData.isString() && (newData.val() == 'application/pdf' || newData.val() == 'image/jpeg' || newData.val() == 'image/png' || newData.val() == 'image/webp')"
            },
            "size": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 5242880"
            },
            "path": {
              ".validate": "newData.isString() && newData.val().length <= 300 && newData.val().beginsWith('quote-attachments/' + $submission + '/')"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "timestamp": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() == 'new' || (auth != null && auth.token.email == 'aaronreifschneider@outlook.com' && (newData.val() == 'viewed' || newData.val() == 'replied')))"
        },
        "viewed": {
          ".validate": "newData.isBoolean()"
        },
        "replied": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "email_recipients": {
      ".read": "auth != null && auth.token.email == 'aaronreifschneider@outlook.com'",
      "$recipient": {
        ".write": "auth != null && auth.token.email == 'aaronreifschneider@outlook.com'",
        ".validate": "newData.hasChildren(['name', 'email'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length > 3 && newData.val().length <= 254 && newData.val().matches(/^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
